{
  "name": "@local/ton-decompiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TON code-cell BOC to verified FunC, implemented in TypeScript",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@ton-community/func-js": "0.11.0",
    "@ton/core": "0.63.1",
    "@ton/tasm": "0.6.2"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  }
}
